local function clearPlayerVisuals(player, character)
    if not character then
        return
    end
    removeHighlight(character)
    removeNameTag(character)
    removeTracer(character)
    removeBox(character)
end

local function refreshPlayerEsp(player)
    local character = player and player.Character
    if not character then
        return
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        if settings.highlightEnabled then
            createHighlight(character)
        else
            clearPlayerVisuals(player, character)
        end
        task.defer(updateEsp)
        return
    end
    if humanoid.Health <= 0 then
        if settings.highlightEnabled then
            createHighlight(character)
        else
            clearPlayerVisuals(player, character)
        end
        task.defer(updateEsp)
        return
    end
    task.defer(updateEsp)
end

local function connectPlayerLifecycle(player)
    if playerConnections[player] then
        return
    end

    local connections = {}

    connections.characterAdded = player.CharacterAdded:Connect(function(character)
        local humanoid = character:WaitForChild("Humanoid", 5)
        if humanoid then
            humanoid.Died:Connect(function()
                -- keep highlight on dead body and refresh ESP state
                task.defer(updateEsp)
            end)
        end

        task.defer(function()
            refreshPlayerEsp(player)
        end)
    end)

    connections.characterRemoving = player.CharacterRemoving:Connect(function(character)
        clearPlayerVisuals(player, character)
        task.defer(updateEsp)
    end)

    playerConnections[player] = connections
end

local function disconnectPlayerLifecycle(player)
    local connections = playerConnections[player]
    if not connections then
        return
    end

    for _, conn in pairs(connections) do
        if conn then
            conn:Disconnect()
        end
    end
    playerConnections[player] = nil
end

local function updateEsp()
    local cam = getCamera()
    if not cam then
        return
    end

    if not settings.espEnabled then
        for character in pairs(highlights) do
            removeHighlight(character)
        end
        for character in pairs(nameTags) do
            removeNameTag(character)
        end
        for character in pairs(tracerLines) do
            removeTracer(character)
        end
        for character in pairs(boxLines) do
            removeBox(character)
        end
        return
    end

    local activePlayers = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) then
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            if character then
                if humanoid then
                    if humanoid.Health > 0 then
                        activePlayers[character] = player
                        if settings.highlightEnabled then
                            createHighlight(character)
                        else
                            removeHighlight(character)
                        end
                        if settings.boxEnabled then
                            createBox(character)
                        else
                            removeBox(character)
                        end
                        if settings.nameEspEnabled or settings.weaponEspEnabled then
                            createNameTag(player, character)
                        else
                            removeNameTag(character)
                        end
                        if settings.tracerEnabled then
                            createTracer(character)
                        else
                            removeTracer(character)
                        end
                    else
                        if settings.highlightEnabled then
                            createHighlight(character)
                        else
                            removeHighlight(character)
                        end
                        removeBox(character)
                        removeNameTag(character)
                        removeTracer(character)
                    end
                else
                    if settings.highlightEnabled then
                        createHighlight(character)
                    else
                        clearPlayerVisuals(nil, character)
                    end
                end
            end
        else
            local character = player.Character
            if character then
                clearPlayerVisuals(nil, character)
            end
        end
    end

    for character in pairs(tracerLines) do
        if not activePlayers[character] then
            removeTracer(character)
        end
    end

    for character, line in pairs(tracerLines) do
        local player = activePlayers[character]
        if player and character.PrimaryPart then
            local head = character:FindFirstChild("Head")
            local position = head and head.Position or character.PrimaryPart.Position
            local screenPos, onScreen = cam:WorldToViewportPoint(position)
            if onScreen then
                line.From = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
                line.To = Vector2.new(screenPos.X, screenPos.Y)
                line.Visible = true
                line.Color = settings.espEnabled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 180)

                local box = boxLines[character]
                if box and settings.boxEnabled then
                    local root = character.PrimaryPart or character:FindFirstChild("HumanoidRootPart")
                    local head = character:FindFirstChild("Head")
                    if root and head then
                        local topPos = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.6, 0))
                        local bottomPos = cam:WorldToViewportPoint(root.Position - Vector3.new(0, 3.0, 0))
                        local height = math.max(40, math.abs(topPos.Y - bottomPos.Y))
                        local width = math.max(24, height * 0.5)
                        local centerX = (topPos.X + bottomPos.X) / 2
                        local topY = math.min(topPos.Y, bottomPos.Y)
                        box.Size = Vector2.new(width, height)
                        box.Position = Vector2.new(centerX - width / 2, topY)
                        box.Visible = true
                    else
                        box.Visible = false
                    end
                elseif box then
                    box.Visible = false
                end
            else
                line.Visible = false
                local box = boxLines[character]
                if box then
                    box.Visible = false
                end
            end
        else
            line.Visible = false
        end
    end
end

local function getClosestTarget()
    local cam = getCamera()
    if not cam then
        return nil
    end

    local viewport = cam.ViewportSize
    local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
    local closest, bestDistance = nil, settings.FOV

    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) then
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            if character and humanoid and humanoid.Health > 0 then
                local targetPart = getAimTargetPart(character)
                if targetPart and ((not settings.wallCheckEnabled) or isVisible(targetPart)) then
                    local screenPos, onScreen = cam:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local distance = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                        if distance <= settings.FOV and distance < bestDistance then
                            bestDistance = distance
                            closest = targetPart
                        end
                    end
                end
            end
        end
    end
    return closest
end

local aiming = false

UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        aiming = true
    end

    local function inputToKeyString(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            return "MouseButton1"
        elseif inp.UserInputType == Enum.UserInputType.MouseButton2 then
            return "MouseButton2"
        elseif inp.KeyCode and inp.KeyCode ~= Enum.KeyCode.Unknown then
            return tostring(inp.KeyCode):gsub("Enum.KeyCode.", "")
        end
        return nil
    end

    local keyStr = inputToKeyString(input)
    if not keyStr then return end

    local isBoundKey = settings.keybinds and (
        keyStr == settings.keybinds.aim or
        keyStr == settings.keybinds.esp or
        keyStr == settings.keybinds.minimize
    )
    if gameProcessedEvent and not isBoundKey then
        return
    end

    -- Aim bind: toggle aimbot
    if settings.keybinds and settings.keybinds.aim and keyStr == settings.keybinds.aim then
        settings.aimEnabled = not settings.aimEnabled
        updateGui()
        return
    end

    -- ESP bind: toggle esp
    if settings.keybinds and settings.keybinds.esp and keyStr == settings.keybinds.esp then
        settings.espEnabled = not settings.espEnabled
        updateGui()
        return
    end

    -- Hide/show bind: toggle full GUI visibility
    if settings.keybinds and settings.keybinds.minimize and keyStr == settings.keybinds.minimize then
        setGuiVisible(not settings.guiVisible)
        updateGui()
        return
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        aiming = false
    end
end)

RunService.RenderStepped:Connect(function()
    local cam = getCamera()
    if cam and fovCircle then
        fovCircle.Visible = settings.aimEnabled and settings.showFovCircle
        fovCircle.Radius = settings.FOV
        fovCircle.Position = centerPoint()
    end
    updateEsp()

    

    if settings.aimEnabled and aiming then
        local target = getClosestTarget()
        if target and cam then
            local origin = cam.CFrame.Position
            local destination = target.Position
            local lookAt = CFrame.lookAt(origin, destination)
            local targetCFrame = lookAt
            if settings.aimSmoothEnabled then
                cam.CFrame = cam.CFrame:Lerp(targetCFrame, settings.smoothness)
            else
                cam.CFrame = targetCFrame
            end

            
        end
    end
end)

