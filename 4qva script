local function isEnemy(player)
    if not player or player == LocalPlayer then
        return false
    end
    if LocalPlayer.Team and player.Team and LocalPlayer.Team ~= player.Team then
        return true
    end
    return LocalPlayer.Team == nil or player.Team == nil
end

local function getAimTargetPart(character)
    if not character then
        return nil
    end
    -- Prefer the head for more accurate aiming; fall back to root/torso if head not present
    return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
end

local function isVisible(part)
    if not part then
        return true
    end
    local cam = getCamera()
    if not cam then
        return true
    end
    local origin = cam.CFrame.Position
    local direction = part.Position - origin
    local distance = math.clamp(direction.Magnitude, 1, settings.maxDistance)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = { LocalPlayer.Character, cam }
    local result = workspace:Raycast(origin, direction.Unit * distance, params)
    return not result or result.Instance == part or result.Instance:IsDescendantOf(part.Parent)
end

local function createHighlight(character)
    if highlights[character] then
        return
    end
    local highlight = Instance.new("Highlight")
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.FillColor = Color3.fromRGB(255, 120, 120)
    highlight.OutlineColor = Color3.fromRGB(255, 180, 80)
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character
    highlights[character] = highlight
end

local function removeHighlight(character)
    local highlight = highlights[character]
    if highlight then
        highlight:Destroy()
        highlights[character] = nil
    end
end

local boxLines = {}
local function createBox(character)
    if boxLines[character] then
        return
    end
    local box = createDrawing("Square")
    if not box then
        return
    end
    box.Color = Color3.fromRGB(255, 255, 255)
    box.Thickness = 2
    box.Transparency = 0.7
    box.Filled = false
    box.Visible = false
    boxLines[character] = box
end

local function removeBox(character)
    local box = boxLines[character]
    if box then
        box:Remove()
        boxLines[character] = nil
    end
end

local function getEquippedToolName(player)
    local character = player and player.Character
    if not character then
        return nil
    end

    local tool = character:FindFirstChildOfClass("Tool")
    if not tool then
        return nil
    end

    local rawName = tostring(tool.Name or "")
    local cleanedName = rawName
        :gsub("%s*%(%d+%)", "")
        :gsub("%s*%[%d+%]", "")
        :gsub("%s+%d+$", "")
        :gsub("%s*[-_]+%d+$", "")
        :gsub("^Tool%s*", "")
        :gsub("^Weapon%s*", "")
        :gsub("%s+$", "")

    local digitsOnly = cleanedName:gsub("%s+", "")
    if cleanedName == "" or cleanedName == "Tool" or cleanedName == "Weapon" or digitsOnly:match("^%d+$") then
        return nil
    end

    return cleanedName
end

local function createNameTag(player, character)
        if not character then
            return
        end

        local head = character:FindFirstChild("Head")
        if not head then
            return
        end

        local billboard = nameTags[character]
        local label
        if billboard then
            label = billboard:FindFirstChildOfClass("TextLabel")
        else
            billboard = Instance.new("BillboardGui")
            billboard.Name = "NameEsp"
            billboard.Adornee = head
            billboard.AlwaysOnTop = true
            billboard.Size = UDim2.new(0, 140, 0, 30)
            billboard.StudsOffset = Vector3.new(0, 2.2, 0)
            billboard.Parent = Gui

            label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, 0, 1, 0)
            label.BackgroundTransparency = 1
            label.TextColor3 = Color3.new(1, 1, 1)
            label.TextStrokeTransparency = 0
            label.TextScaled = true
            label.Font = Enum.Font.GothamBold
            label.Parent = billboard

            nameTags[character] = billboard
        end

        local weaponName = getEquippedToolName(player)
        local labelText = ""
        if settings.nameEspEnabled then
            if player == LocalPlayer and settings.hideLocalNameEnabled then
                labelText = ""
            else
                labelText = player.Name
            end
        end
        if settings.weaponEspEnabled and weaponName then
            if labelText ~= "" then
                labelText = labelText .. " | " .. weaponName
            else
                labelText = weaponName
            end
        end
        label.Text = labelText
    end

local function removeNameTag(character)
    local tag = nameTags[character]
    if tag then
        tag:Destroy()
        nameTags[character] = nil
    end
end

local function createTracer(character)
