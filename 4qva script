        end

        local billboard = nameTags[character]
        local label
        if billboard then
            label = billboard:FindFirstChildOfClass("TextLabel")
        else
            billboard = Instance.new("BillboardGui")
            billboard.Name = "NameEsp"
            billboard.Adornee = head
            billboard.AlwaysOnTop = true
            billboard.Size = UDim2.new(0, 140, 0, 30)
            billboard.StudsOffset = Vector3.new(0, 2.2, 0)
            billboard.Parent = Gui

            label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, 0, 1, 0)
            label.BackgroundTransparency = 1
            label.TextColor3 = Color3.new(1, 1, 1)
            label.TextStrokeTransparency = 0
            label.TextScaled = true
            label.Font = Enum.Font.GothamBold
            label.Parent = billboard

            nameTags[character] = billboard
        end

        local weaponName = getEquippedToolName(player)
        local labelText = ""
        if settings.nameEspEnabled then
            if player == LocalPlayer and settings.hideLocalNameEnabled then
                labelText = ""
            else
                labelText = player.Name
            end
        end
        if settings.weaponEspEnabled and weaponName then
            if labelText ~= "" then
                labelText = labelText .. " | " .. weaponName
            else
                labelText = weaponName
            end
        end
        label.Text = labelText
    end

local function removeNameTag(character)
    local tag = nameTags[character]
    if tag then
        tag:Destroy()
        nameTags[character] = nil
    end
end

local function createTracer(character)
    if tracerLines[character] then
        return
    end
    local line = createDrawing("Line")
    if not line then
        return
    end
    line.Color = Color3.fromRGB(255, 255, 255)
    line.Thickness = 2
    line.Transparency = 0.7
    line.Visible = false
    tracerLines[character] = line
end

local function removeTracer(character)
    local line = tracerLines[character]
    if line then
        line:Remove()
        tracerLines[character] = nil
    end
end

local function clearPlayerVisuals(player, character)
    if not character then
        return
    end
    removeHighlight(character)
    removeNameTag(character)
    removeTracer(character)
    removeBox(character)
end

local function refreshPlayerEsp(player)
    local character = player and player.Character
    if not character then
        return
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        clearPlayerVisuals(player, character)
        return
    end
    task.defer(function()
        updateEsp()
    end)
end

local function connectPlayerLifecycle(player)
    if playerConnections[player] then
        return
    end

    local connections = {}

    connections.characterAdded = player.CharacterAdded:Connect(function(character)
        local humanoid = character:WaitForChild("Humanoid", 5)
        if humanoid then
            humanoid.Died:Connect(function()
                clearPlayerVisuals(player, character)
                task.defer(updateEsp)
            end)
        end

        task.defer(function()
            refreshPlayerEsp(player)
        end)
    end)

    connections.characterRemoving = player.CharacterRemoving:Connect(function(character)
        clearPlayerVisuals(player, character)
        task.defer(updateEsp)
    end)

    playerConnections[player] = connections
end

local function disconnectPlayerLifecycle(player)
    local connections = playerConnections[player]
    if not connections then
        return
    end

    for _, conn in pairs(connections) do
        if conn then
            conn:Disconnect()
        end
    end
    playerConnections[player] = nil
end

local function updateEsp()
    local cam = getCamera()
    if not cam then
        return
    end

    local activePlayers = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) then
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            if character and humanoid and humanoid.Health > 0 then
                activePlayers[character] = player
                if settings.highlightEnabled then
                    createHighlight(character)
                else
                    removeHighlight(character)
                end
                if settings.boxEnabled then
                    createBox(character)
                else
                    removeBox(character)
                end
                if settings.nameEspEnabled or settings.weaponEspEnabled then
                    createNameTag(player, character)
                else
                    removeNameTag(character)
                end
                if settings.tracerEnabled then
                    createTracer(character)
                else
                    removeTracer(character)
                end
            else
                clearPlayerVisuals(nil, character)
            end
        else
            local character = player.Character
            if character then
                clearPlayerVisuals(nil, character)
            end
        end
    end

    for character in pairs(tracerLines) do
        if not activePlayers[character] then
            clearPlayerVisuals(nil, character)
        end
    end

    for character, line in pairs(tracerLines) do
        local player = activePlayers[character]
        if player and character.PrimaryPart then
            local head = character:FindFirstChild("Head")
            local position = head and head.Position or character.PrimaryPart.Position
            local screenPos, onScreen = cam:WorldToViewportPoint(position)
            if onScreen then
                line.From = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
                line.To = Vector2.new(screenPos.X, screenPos.Y)
                line.Visible = true
                line.Color = settings.espEnabled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 180)

                local box = boxLines[character]
                if box and settings.boxEnabled then
                    local root = character.PrimaryPart or character:FindFirstChild("HumanoidRootPart")
                    local head = character:FindFirstChild("Head")
                    if root and head then
                        local topPos = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.6, 0))
                        local bottomPos = cam:WorldToViewportPoint(root.Position - Vector3.new(0, 3.0, 0))
                        local height = math.max(40, math.abs(topPos.Y - bottomPos.Y))
                        local width = math.max(24, height * 0.5)
                        local centerX = (topPos.X + bottomPos.X) / 2
                        local topY = math.min(topPos.Y, bottomPos.Y)
                        box.Size = Vector2.new(width, height)
                        box.Position = Vector2.new(centerX - width / 2, topY)
                        box.Visible = true
                    else
                        box.Visible = false
                    end
                elseif box then
                    box.Visible = false
                end
            else
                line.Visible = false
                local box = boxLines[character]
                if box then
                    box.Visible = false
                end
            end
        else
            line.Visible = false
        end
    end
end

local function getClosestTarget()
    local cam = getCamera()
    if not cam then
        return nil
    end

    local viewport = cam.ViewportSize
    local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
    local closest, bestDistance = nil, settings.FOV

    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) then
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            if character and humanoid and humanoid.Health > 0 then
                local targetPart = getAimTargetPart(character)
                if targetPart and ((not settings.wallCheckEnabled) or isVisible(targetPart)) then
                    local screenPos, onScreen = cam:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local distance = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                        if distance <= settings.FOV and distance < bestDistance then
                            bestDistance = distance
                            closest = targetPart
                        end
                    end
                end
            end
        end
    end
    return closest
end

local aiming = false

UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        aiming = true
    end
    if input.KeyCode == Enum.KeyCode.RightControl then
        settings.guiVisible = not settings.guiVisible
        MainFrame.Visible = settings.guiVisible
    end
    if gameProcessedEvent then
        return
    end
    if input.KeyCode == Enum.KeyCode.T then
        settings.aimEnabled = not settings.aimEnabled
        updateGui()
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        aiming = false
    end
end)

RunService.RenderStepped:Connect(function()
    local cam = getCamera()
    if cam and fovCircle then
        fovCircle.Visible = settings.aimEnabled
        fovCircle.Radius = settings.FOV
        fovCircle.Position = centerPoint()
    end
    updateEsp()

    if settings.aimEnabled and aiming then
        local target = getClosestTarget()
        if target and cam then
            local origin = cam.CFrame.Position
            local destination = target.Position
            local lookAt = CFrame.lookAt(origin, destination)
            if settings.aimSmoothEnabled then
                cam.CFrame = cam.CFrame:Lerp(lookAt, settings.smoothness)
            else
                cam.CFrame = lookAt
            end
        end
    end
end)

--- Cleanup old objects if needed
for _, player in ipairs(Players:GetPlayers()) do
    connectPlayerLifecycle(player)
end

Players.PlayerAdded:Connect(function(player)
    connectPlayerLifecycle(player)
end)

Players.PlayerRemoving:Connect(function(player)
    disconnectPlayerLifecycle(player)
    local character = player.Character
    if character then
        clearPlayerVisuals(player, character)
    end
end)
