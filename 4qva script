local configFileName = "4qva_config.json"

local function saveConfig()
    if type(writefile) ~= "function" then
        return
    end

    local saved = {}
    for key, value in pairs(settings) do
        if type(value) ~= "function" and type(value) ~= "table" then
            saved[key] = value
        end
    end
    if settings.keybinds and type(settings.keybinds) == "table" then
        saved.keybinds = settings.keybinds
    end

    local json = HttpService:JSONEncode(saved)
    pcall(function()
        writefile(configFileName, json)
    end)
end

local function loadConfig()
    if type(isfile) ~= "function" or type(readfile) ~= "function" then
        return
    end

    if not isfile(configFileName) then
        return
    end

    local ok, content = pcall(readfile, configFileName)
    if not ok or not content then
        return
    end

    local success, data = pcall(function()
        return HttpService:JSONDecode(content)
    end)
    if not success or type(data) ~= "table" then
        return
    end

    for key, value in pairs(data) do
        if key == "keybinds" and type(value) == "table" and type(settings[key]) == "table" then
            for bindKey, bindValue in pairs(value) do
                if settings[key][bindKey] ~= nil then
                    settings[key][bindKey] = bindValue
                end
            end
        elseif settings[key] ~= nil then
            settings[key] = value
        end
    end
end

