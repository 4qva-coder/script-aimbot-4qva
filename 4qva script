        local head = character:FindFirstChild("Head")
        if not head then
            return
        end

        local billboard = nameTags[character]
        local label
        if billboard then
            label = billboard:FindFirstChildOfClass("TextLabel")
        else
            billboard = Instance.new("BillboardGui")
            billboard.Name = "NameEsp"
            billboard.Adornee = head
            billboard.AlwaysOnTop = true
            billboard.Size = UDim2.new(0, 140, 0, 30)
            billboard.StudsOffset = Vector3.new(0, 2.2, 0)
            billboard.Parent = Gui

            label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, 0, 1, 0)
            label.BackgroundTransparency = 1
            label.TextColor3 = Color3.new(1, 1, 1)
            label.TextStrokeTransparency = 0
            label.TextScaled = true
            label.Font = Enum.Font.GothamBold
            label.Parent = billboard

            nameTags[character] = billboard
        end

        local weaponName = getEquippedToolName(player)
        local labelText = ""
        if settings.nameEspEnabled then
            labelText = player.Name
        end
        if settings.weaponEspEnabled and weaponName then
            if labelText ~= "" then
                labelText = labelText .. " | " .. weaponName
            else
                labelText = weaponName
            end
        end
        label.Text = labelText
    end

local function removeNameTag(character)
    local tag = nameTags[character]
    if tag then
        tag:Destroy()
        nameTags[character] = nil
    end
end

